# Copy this file to scripts/device.env and fill in your device's SSH password.
# scripts/deploy.sh sources scripts/device.env automatically if it exists, and
# scripts/device.env is gitignored, so the secret never lands in the repo.
#
# DEVICE_SSH_HOST=127.0.0.1   # USB (via iproxy); use the phone's Wi-Fi IP instead to go wireless
# DEVICE_SSH_PORT=2222        # local iproxy port for USB; use 22 for a Wi-Fi deploy
# DEVICE_SSH_USER=root
# USB_DEVICE_SSH_PORT=22      # the device's own sshd port (Amethyst/Procursus = 22)
DEVICE_SSH_PASS="alpine"
